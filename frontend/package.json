{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && npm run generate:sitemap",
        "build:dynamic-sitemap": "tsc && vite build && SITEMAP_DYNAMIC=1 npm run generate:sitemap",
        "build:ssg": "tsc && vite build && npm run generate:sitemap && npm run prerender",
        "prerender": "npx esbuild --bundle scripts/prerender.tsx --format=cjs --platform=node --target=node20 --alias:@=src --loader:.css=text --outfile=.ssg/prerender.cjs && node .ssg/prerender.cjs",
        "generate:sitemap": "npx esbuild --bundle scripts/generate-sitemap.ts --format=cjs --platform=node --target=node20 --outfile=.ssg/generate-sitemap.cjs && node .ssg/generate-sitemap.cjs",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src scripts --quiet",
        "test": "vitest run",
        "validate:env": "npx esbuild --bundle scripts/validate-public-env.ts --format=cjs --platform=node --target=node20 --outfile=.ssg/validate-public-env.cjs && node .ssg/validate-public-env.cjs",
        "quality": "npm run typecheck && npm run lint && npm run test && npm run validate:env && npm audit --omit=dev",
        "lint:debt": "eslint src scripts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.1.16",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react-swc": "^4.2.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.16",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^7.1.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.15",
        "@fullcalendar/daygrid": "^6.1.15",
        "@fullcalendar/interaction": "^6.1.15",
        "@fullcalendar/react": "^6.1.15",
        "@fullcalendar/timegrid": "^6.1.15",
        "@headlessui/react": "^2.2.9",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.13.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^12.23.24",
        "lucide-react": "^0.548.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router": "8.3.0",
        "tailwind-merge": "^3.3.1",
        "tailwindcss-animate": "^1.0.7"
    }
}
