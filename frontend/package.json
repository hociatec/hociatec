{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && npm run generate:sitemap",
        "build:analyze": "BUNDLE_ANALYZE=1 tsc && BUNDLE_ANALYZE=1 vite build && npm run generate:sitemap",
        "build:dynamic-sitemap": "tsc && vite build && SITEMAP_DYNAMIC=1 npm run generate:sitemap",
        "build:ssg": "tsc && vite build && npm run generate:sitemap && npm run prerender",
        "prerender": "npx esbuild --bundle scripts/prerender.tsx --format=cjs --platform=node --target=node20 --alias:@=src --loader:.css=text --outfile=.ssg/prerender.cjs && node .ssg/prerender.cjs",
        "generate:sitemap": "npx esbuild --bundle scripts/generate-sitemap.ts --format=cjs --platform=node --target=node20 --outfile=.ssg/generate-sitemap.cjs && node .ssg/generate-sitemap.cjs",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src scripts --quiet",
        "lint:css": "stylelint \"src/**/*.css\"",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:visual": "playwright test --grep @visual",
        "generate:api-types": "openapi-typescript ../backend/docs/openapi.yaml -o src/shared/api/generated/openapi.ts",
        "check:api-contract": "npm run generate:api-types && git diff --exit-code src/shared/api/generated/openapi.ts",
        "validate:env": "npx esbuild --bundle scripts/validate-public-env.ts --format=cjs --platform=node --target=node20 --outfile=.ssg/validate-public-env.cjs && node .ssg/validate-public-env.cjs",
        "check:cycles": "madge --extensions ts,tsx --ts-config tsconfig.json --circular src",
        "check:architecture": "node scripts/check-feature-boundaries.mjs",
        "check:maintainability": "node scripts/check-maintainability.mjs",
        "check:production-safeguards": "node scripts/check-production-safeguards.mjs",
        "quality": "npm run typecheck && npm run lint && npm run lint:css && npm run test && npm run validate:env && npm run check:api-contract && npm run check:cycles && npm run check:architecture && npm run check:maintainability && npm run check:production-safeguards && npm audit --omit=dev",
        "lint:debt": "eslint src scripts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.1.16",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react-swc": "^4.2.0",
        "autoprefixer": "^10.4.21",
        "axe-core": "^4.12.1",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "jsdom": "^30.0.1",
        "madge": "^8.0.0",
        "msw": "^2.15.0",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.6",
        "rollup-plugin-visualizer": "^7.0.1",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.1",
        "tailwindcss": "^4.1.16",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^7.1.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.15",
        "@fullcalendar/daygrid": "^6.1.15",
        "@fullcalendar/interaction": "^6.1.15",
        "@fullcalendar/react": "^6.1.15",
        "@fullcalendar/timegrid": "^6.1.15",
        "@headlessui/react": "^2.2.9",
        "@hookform/resolvers": "^5.7.1",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@sentry/react": "^10.69.0",
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.13.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^12.23.24",
        "lucide-react": "^0.548.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.84.0",
        "react-router": "8.3.0",
        "tailwind-merge": "^3.3.1",
        "tailwindcss-animate": "^1.0.7",
        "web-vitals": "^6.0.1",
        "zod": "^4.4.3"
    }
}
