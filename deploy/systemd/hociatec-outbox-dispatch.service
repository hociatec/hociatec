[Unit]
Description=Hociatec Outbox dispatcher
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/home/ubuntu/hociatec/backend
Environment=APP_ENV=prod
Environment=APP_DEBUG=0
ExecStart=/usr/bin/php /home/ubuntu/hociatec/backend/bin/console app:outbox:dispatch --limit=50 --no-interaction

